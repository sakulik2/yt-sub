{
  "manifest_version": 3,
  "name": "yt-sub",
  "version": "1.3.3",
  "description": "Load ASS/SRT subtitles for YouTube videos with custom styling support",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://*.youtube.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "yt-sub"
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "ass-loader.js",
        "content.js"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
